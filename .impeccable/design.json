      "css": ":host{--n0:#0e1014;--n1:#15181d;--n2:#1c2026;--n3:#262b33;--n4:#3a414c;--n5:#7d8592;--n6:#a9b0ba;--n7:#eef0f3;--g-news:#2f5bb7;--g-drama:#6a45b8;--g-movies:#b23a3a;--g-sports:#22784d;--radius:4px;font-family:Archivo,ui-sans-serif,system-ui,sans-serif;font-size:15px;color:var(--n7);} .ds-row{padding:1rem;background:var(--n0)} .ds-btn-danger{height:2.25rem;padding:0 .875rem;border:1px solid #7d3a3a;border-radius:var(--radius);background:transparent;color:#ffb9b9;font:inherit;font-weight:600;cursor:pointer;transition:background-color .15s} .ds-btn-danger:hover{background:#3a1c1c} .ds-btn-danger:focus-visible{outline:3px solid #fff;outline-offset:2px}"
    },
