  "narrative": {
    "northStar": "The Palinsesto Sheet",
    "overview": "The interface is the broadcaster's schedule sheet, not an app of cards. Every programme is a rectangle filled flat with its genre's colour and sized exactly by its duration, laid on a night ground of eight neutral steps. The evening reads by colour before a single title is read, and one white vertical rule shows where the evening stands now. Everything that is not the schedule (top bar, legend, ruler, channel plates, the status page) is built from the same neutral ramp and stays quiet so the fills carry the screen.\n\nDensity is high and deliberate: rows are 4.25rem, the minute is the only horizontal unit, and labels are semi-condensed Archivo with tabular figures. Depth comes from tone steps and 1px rules, not from lifted surfaces. The same world scales from a phone to a TV browser driven by a remote; on TV the whole interface grows from a 15px to a 24px root, and every control stays reachable with arrow keys and Enter.\n\nThe rejected default is the category look: grey rounded cards on a slate grid with a blue accent.",
    "keyCharacteristics": [
      "One fixed eight-step neutral ramp is the only tonal scale.",
      "Flat genre fills with white type; no borders, gradients or shadows on slots.",
      "One white now-line with a white time tag; white is reserved for now, selection and focus.",
      "Missing data is hatched, never blank.",
      "Square to 4px corners.",
      "Archivo throughout, semi-condensed in the cells, tabular figures for every time and number."
    ],
    "rules": [
      {
        "name": "The One Ramp Rule",
        "body": "Every non-genre surface, border and text colour comes from the eight night steps. A new grey is a defect.",
        "section": "colors"
      },
      {
        "name": "The White Means Now Rule",
        "body": "Pure white marks now, the current selection and keyboard focus. It is not decoration and not a brand accent.",
        "section": "colors"
      },
      {
        "name": "The Recede By Colour Rule",
        "body": "Ended and filtered-out slots lose colour (mixed 45% toward the panel step, or dropped to the raised step), never contrast; their type stays legible.",
        "section": "colors"
      },
      {
        "name": "The Tabular Clock Rule",
        "body": "Every time and number uses tabular figures so columns of times align down the sheet and tables.",
        "section": "typography"
      },
      {
        "name": "The Root Scale Rule",
        "body": "Sizes are in rem off a 15px root so the TV root of 24px scales the whole interface at once. Do not set type in px.",
        "section": "typography"
      },
      {
        "name": "The Only Floaters Cast Rule",
        "body": "A shadow is allowed only on a surface that overlays the sheet. Anything in the layout flow is flat.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do take every neutral from the eight night steps (`night-0` to `night-7`).",
      "Do give every genre surface its colour through the genre class and its fill variable, with white type.",
      "Do size anything on the sheet in minutes multiplied by the one time unit.",
      "Do hatch missing data with the 135-degree panel and raised stripes.",
      "Do use tabular figures for all times and counts.",
      "Do keep every interactive element reachable by Tab and arrow keys, with the 3px white focus outline.",
      "Do set sizes in rem so the 24px TV root scales the interface."
    ],
    "donts": [
      "Don't put borders, gradients, rounded corners or shadows on programme slots.",
      "Don't use white as a fill or decorative accent; it means now, selection or focus.",
      "Don't dim ended or filtered slots by lowering text contrast; remove colour instead.",
      "Don't introduce a radius above 4px or a new grey outside the ramp.",
      "Don't add shadows to anything that does not float over the sheet.",
      "Don't fall back to grey rounded cards on a slate grid with a blue accent."
    ]
  }
}