      "description": "Ground-coloured field; border turns white on focus.",
      "html": "<div class=\"ds-row\"><input class=\"ds-field\" type=\"search\" placeholder=\"Search titles\"></div>",
      "css": ":host{--n0:#0e1014;--n1:#15181d;--n2:#1c2026;--n3:#262b33;--n4:#3a414c;--n5:#7d8592;--n6:#a9b0ba;--n7:#eef0f3;--g-news:#2f5bb7;--g-drama:#6a45b8;--g-movies:#b23a3a;--g-sports:#22784d;--radius:4px;font-family:Archivo,ui-sans-serif,system-ui,sans-serif;font-size:15px;color:var(--n7);} .ds-row{padding:1rem;background:var(--n1)} .ds-field{width:16rem;height:2.25rem;padding:0 .75rem;border:1px solid var(--n4);border-radius:var(--radius);background:var(--n0);color:var(--n7);font:inherit} .ds-field::placeholder{color:var(--n5)} .ds-field:hover{border-color:var(--n5)} .ds-field:focus-visible{outline:3px solid #fff;outline-offset:0;border-color:#fff}"
    },
    {
      "name": "Top Bar Navigation",
      "kind": "nav",
      "refersTo": "nav-link",
      "description": "Wordmark and text links; current page holds the rule-step fill.",
      "html": "<header class=\"ds-bar\"><a class=\"ds-wordmark\" href=\"#\">HDHomeRun EPG</a><nav class=\"ds-nav\"><a href=\"#\" aria-current=\"page\">Guide</a><a href=\"#\">Status</a><a href=\"#\">API</a></nav></header>",
      "css": ":host{--n0:#0e1014;--n1:#15181d;--n2:#1c2026;--n3:#262b33;--n4:#3a414c;--n5:#7d8592;--n6:#a9b0ba;--n7:#eef0f3;--g-news:#2f5bb7;--g-drama:#6a45b8;--g-movies:#b23a3a;--g-sports:#22784d;--radius:4px;font-family:Archivo,ui-sans-serif,system-ui,sans-serif;font-size:15px;color:var(--n7);} .ds-bar{display:flex;align-items:center;gap:1.5rem;min-height:3.5rem;padding:.5rem 1.25rem;background:var(--n1);border-bottom:1px solid var(--n3)} .ds-wordmark{font-size:1.125rem;font-weight:700;letter-spacing:-.01em;color:var(--n7);text-decoration:none} .ds-nav{display:flex;gap:.25rem} .ds-nav a{padding:.45rem .75rem;border-radius:var(--radius);color:var(--n6);font-weight:500;text-decoration:none;transition:background-color .15s,color .15s} .ds-nav a:hover{color:var(--n7);background:var(--n2)} .ds-nav a[aria-current=\"page\"]{color:var(--n7);background:var(--n3)} .ds-nav a:focus-visible{outline:3px solid #fff;outline-offset:2px}"
    },
    {
      "name": "Genre Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Legend entry that works as the genre filter; selected fills with the genre.",
      "html": "<div class=\"ds-legend\"><button class=\"ds-chip\" style=\"--fill:var(--g-news)\" aria-pressed=\"true\"><i></i>News</button><button class=\"ds-chip\" style=\"--fill:var(--g-drama)\"><i></i>Drama</button><button class=\"ds-chip\" style=\"--fill:var(--g-sports)\"><i></i>Sports</button></div>",
      "css": ":host{--n0:#0e1014;--n1:#15181d;--n2:#1c2026;--n3:#262b33;--n4:#3a414c;--n5:#7d8592;--n6:#a9b0ba;--n7:#eef0f3;--g-news:#2f5bb7;--g-drama:#6a45b8;--g-movies:#b23a3a;--g-sports:#22784d;--radius:4px;font-family:Archivo,ui-sans-serif,system-ui,sans-serif;font-size:15px;color:var(--n7);} .ds-legend{display:flex;gap:.25rem;padding:.375rem 1.25rem;background:var(--n0)} .ds-chip{display:inline-flex;align-items:center;gap:.5rem;height:2rem;padding:0 .75rem;border:0;border-radius:var(--radius);background:transparent;color:var(--n6);font:inherit;font-weight:500;cursor:pointer;transition:background-color .15s,color .15s} .ds-chip i{width:.75rem;height:.75rem;background:var(--fill)} .ds-chip:hover{background:var(--n2);color:var(--n7)} .ds-chip:focus-visible{outline:3px solid #fff;outline-offset:2px} .ds-chip[aria-pressed=\"true\"]{background:var(--fill);color:#fff} .ds-chip[aria-pressed=\"true\"] i{background:#fff}"
    },
    {
      "name": "Programme Lane with Now-line",
      "kind": "custom",
      "refersTo": "slot",
      "description": "Signature: flat genre slots sized by minutes, hatched gaps, the white now-line.",
      "html": "<div class=\"ds-lane\"><button class=\"ds-slot ds-ended\" style=\"left:0;width:30%;--fill:var(--g-news)\"><b>Tg1</b><time>19:00</time></button><button class=\"ds-slot\" style=\"left:30%;width:45%;--fill:var(--g-drama)\"><b>Blue Bloods</b><time>19:30</time></button><button class=\"ds-slot\" style=\"left:80%;width:20%;--fill:var(--g-movies)\"><b>Film</b><time>21:00</time></button><span class=\"ds-now\"></span><span class=\"ds-tag\">19:45</span></div>",
      "css": ":host{--n0:#0e1014;--n1:#15181d;--n2:#1c2026;--n3:#262b33;--n4:#3a414c;--n5:#7d8592;--n6:#a9b0ba;--n7:#eef0f3;--g-news:#2f5bb7;--g-drama:#6a45b8;--g-movies:#b23a3a;--g-sports:#22784d;--radius:4px;font-family:Archivo,ui-sans-serif,system-ui,sans-serif;font-size:15px;color:var(--n7);} .ds-lane{position:relative;height:4.25rem;margin:1.5rem 1rem 1rem;background:repeating-linear-gradient(135deg,var(--n1) 0 .375rem,var(--n2) .375rem .5rem)} .ds-slot{position:absolute;top:0;bottom:0;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;gap:.125rem;padding:0 .625rem 0 .5rem;border:0;border-radius:0;background:var(--fill);color:#fff;box-shadow:inset -2px 0 0 var(--n0);font:inherit;font-stretch:87.5%;text-align:left;cursor:pointer;transition:filter .15s} .ds-slot b{font-size:.875rem;font-weight:600} .ds-slot time{font-size:.75rem;font-variant-numeric:tabular-nums} .ds-slot:hover{filter:brightness(1.15)} .ds-slot:focus-visible{outline:3px solid #fff;outline-offset:-3px} .ds-ended{background:color-mix(in srgb,var(--fill) 45%,var(--n1))} .ds-now{position:absolute;top:0;bottom:0;left:50%;width:2px;background:#fff;pointer-events:none} .ds-tag{position:absolute;top:-1.4rem;left:50%;margin-left:2px;padding:.0625rem .375rem;border-radius:2px;background:#fff;color:var(--n0);font-size:.75rem;font-weight:700;line-height:1.25rem;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Channel Plate",
      "kind": "custom",
      "refersTo": "channel-plate",
      "description": "Sticky channel identity: tabular number, logo well (hatched when missing), name.",
      "html": "<div class=\"ds-plate\"><span class=\"ds-num\">10</span><span class=\"ds-logo\"></span><span class=\"ds-name\">Telelombardia</span></div>",
      "css": ":host{--n0:#0e1014;--n1:#15181d;--n2:#1c2026;--n3:#262b33;--n4:#3a414c;--n5:#7d8592;--n6:#a9b0ba;--n7:#eef0f3;--g-news:#2f5bb7;--g-drama:#6a45b8;--g-movies:#b23a3a;--g-sports:#22784d;--radius:4px;font-family:Archivo,ui-sans-serif,system-ui,sans-serif;font-size:15px;color:var(--n7);} .ds-plate{display:grid;grid-template-columns:2.25rem 3.5rem minmax(0,1fr);align-items:center;gap:.625rem;width:15rem;height:4.25rem;padding:0 .75rem 0 .5rem;background:var(--n1);border-right:1px solid var(--n3)} .ds-num{color:var(--n6);font-size:.875rem;text-align:right;font-variant-numeric:tabular-nums} .ds-logo{height:2.25rem;border-radius:3px;background:repeating-linear-gradient(135deg,var(--n1) 0 .375rem,var(--n2) .375rem .5rem)} .ds-name{overflow:hidden;font-weight:600;text-overflow:ellipsis;white-space:nowrap}"
